{
  "ConnectionStrings": {
    "Default": "",
    "Migrations": ""
  },
  "Jwt": {
    "Issuer": "fuelup",
    "Audience": "fuelup-clients",
    "AccessMinutes": 10
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Files": {
    "Root": "./files"
  },
  "Seed": {
    "Demo": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AppRole": "fuelup_app"
  },
  "DataProtection": {
    "KeysPath": "./keys"
  },
  "Lockout": {
    "MaxFailures": 5,
    "Minutes": 15
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "UploadsPerMinute": 30,
    "ApiPerMinute": 300,
    "ApiBurst": 120
  },
  "Sessions": {
    "WebHours": 12,
    "WebIdleHours": 2,
    "MobileDays": 30,
    "MobileIdleDays": 14
  },
  "Proxy": {
    "TrustedNetworks": ""
  },
  "Alerts": {
    "WebhookUrl": ""
  }
}