# Copy to .env and fill in. NEVER commit .env (it is in .gitignore). Keep a copy in your password manager / secret vault.
# Generate each secret with:  openssl rand -hex 32   (hex avoids characters that need escaping in connection strings)

POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Signs session tokens. Changing it signs everybody out (use it after a suspected leak).
JWT_KEY=

# Public host name of the dashboard (used for CORS), e.g. fuelup.example.com
PUBLIC_HOST=localhost

# First start only — creates the first company and its administrator (who must enrol two-step verification at first sign-in).
# Remove these three values after the first successful start.
BOOTSTRAP_COMPANY=
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: Slack/Teams/SIEM incoming-webhook URL that receives high-severity security alerts.
ALERT_WEBHOOK_URL=

# Demo data has a public password: keep false outside a throw-away test environment.
SEED_DEMO=false
SEED_DEMO_ALLOW=false

# Encrypted backups (deploy/backup.sh): the PUBLIC age key. The matching private key is kept OFFLINE, not on this server.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
